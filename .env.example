# Database (Docker)
DB_PORT=27018
DB_USER=tlp4
DB_PASSWORD=tlp4
DB_NAME=tp_integrador

# Backend
PORT=3000
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=1h
# Used only when running the backend outside Docker (compose builds its own URI with host "db").
MONGO_URI=mongodb://tlp4:tlp4@localhost:27018/tp_integrador?authSource=admin
# Allowed frontend origin(s), comma-separated.
CORS_ORIGIN=http://localhost:5173

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000/api
